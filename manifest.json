{
  "manifest_version": 3,
  "name": "Photos Bookmark",
  "version": "1.4",
  "description": "إضافة لحفظ الصور المفضلة",
  "permissions": [
    "storage",
    "downloads",
    "contextMenus",
    "notifications",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' https://fonts.googleapis.com https://cdn.jsdelivr.net 'unsafe-inline'"
  },
  "web_accessible_resources": [{
    "resources": ["js/*.js"],
    "matches": ["<all_urls>"]
  }]
}

